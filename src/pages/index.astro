---
import { DEFAULT_LOCALE, LOCALES } from '../i18n';

/*
 * `/` belongs to no language: it sends the browser to the one it prefers,
 * or to the default. Without JavaScript the meta refresh does it.
 */
const fallback = `/${DEFAULT_LOCALE}/`;
---

<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Mirrowick</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {LOCALES.map((l) => <link rel="alternate" hreflang={l} href={new URL(`/${l}/`, Astro.site)} />)}
    <script is:inline define:vars={{ locales: LOCALES, fallback }}>
      let saved = null;
      try {
        saved = localStorage.getItem('mirrowick.lang');
      } catch {}
      const wanted = [saved, ...(navigator.languages || [navigator.language])]
        .filter(Boolean)
        .map((l) => l.toLowerCase().split('-')[0])
        .find((l) => locales.includes(l));
      location.replace(wanted ? `/${wanted}/` : fallback);
    </script>
    <meta http-equiv="refresh" content={`0;url=${fallback}`} />
    <style>
      html {
        background: #050608;
      }
    </style>
  </head>
  <body>
    <noscript><a href={fallback}>Mirrowick</a></noscript>
  </body>
</html>
