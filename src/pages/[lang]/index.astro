---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/home/Hero.astro';
import Tales from '../../components/home/Tales.astro';
import Worlds from '../../components/home/Worlds.astro';
import Light from '../../components/home/Light.astro';
import Bestiary from '../../components/home/Bestiary.astro';
import Craft from '../../components/home/Craft.astro';
import Status from '../../components/home/Status.astro';
import NewsTeaser from '../../components/home/NewsTeaser.astro';
import { LOCALES, type Locale } from '../../i18n';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
---

<Base lang={lang}>
  <Hero lang={lang} />
  <Tales lang={lang} />
  <Worlds lang={lang} />
  <Light lang={lang} />
  <Bestiary lang={lang} />
  <Craft lang={lang} />
  <Status lang={lang} />
  <NewsTeaser lang={lang} />
</Base>
