---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/home/Hero.astro';
import Tales from '../../components/home/Tales.astro';
import Gallery from '../../components/home/Gallery.astro';
import Divider from '../../components/Divider.astro';
import Status from '../../components/home/Status.astro';
import NewsTeaser from '../../components/home/NewsTeaser.astro';
import { LOCALES, type Locale } from '../../i18n';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
---

<Base lang={lang}>
  <Hero lang={lang} />
  <Tales lang={lang} />
  <Gallery lang={lang} />
  <Divider />
  <Status lang={lang} />
  <NewsTeaser lang={lang} />
</Base>
