---
import Base from '../../../layouts/Base.astro';
import PostCard from '../../../components/PostCard.astro';
import Heading from '../../../components/Heading.astro';
import { LOCALES, t, type Locale } from '../../../i18n';
import { postsIn } from '../../../lib/news';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const m = t(lang).news;
const posts = await postsIn(lang);
---

<Base lang={lang} title={m.title} description={m.lead}>
  <section class="section page">
    <div class="wrap">
      <Heading as="h1" kicker={m.kicker} title={m.title} lead={m.lead} sign="11" />
      {
        posts.length ? (
          <div class="grid">
            {posts.map((post) => (
              <PostCard post={post} lang={lang} />
            ))}
          </div>
        ) : (
          <p class="lead">{m.none}</p>
        )
      }
    </div>
  </section>
</Base>

<style>
  .page {
    padding-top: clamp(48px, 8vw, 100px);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: 20px;
  }
</style>
