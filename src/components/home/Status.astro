---
import Heading from '../Heading.astro';
import { t, type Locale } from '../../i18n';
import { PLAY_URL } from '../../site';

interface Props {
  lang: Locale;
}

const m = t(Astro.props.lang);
const s = m.status;
---

<section class="section status" id="play">
  <div class="wrap grid">
    <div class="where" data-reveal>
      <Heading kicker={s.kicker} title={s.title} lead={s.lead} sign="07" />
      <h3 class="eyebrow">{s.platforms}</h3>
      <a class="platform live" href={PLAY_URL} target="_blank" rel="noopener">
        <span class="name"><i class="pebble"></i>{s.browser}</span>
        <span class="url">play.mirrowick.com →</span>
      </a>
      <div class="platform">
        <span class="name">{s.steamSoon}</span>
        <span class="url">Steam</span>
      </div>
      <a class="btn btn-primary" href={PLAY_URL} target="_blank" rel="noopener">{m.hero.play}</a>
    </div>

    <!-- What the demo has, typed on a sheet as the Facility's notes are. -->
    <div class="note" data-reveal>
      <h3>{s.has}</h3>
      <ul>
        {s.items.map((item) => <li>{item}</li>)}
      </ul>
      <p class="caveat">{s.caveat}</p>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(40px, 7vw, 110px);
    align-items: center;
  }

  h3.eyebrow {
    margin: 2em 0 12px;
  }

  .where {
    display: grid;
    gap: 12px;
  }

  .where :global(.heading) {
    margin-bottom: 0;
  }

  .platform {
    display: grid;
    gap: 2px;
    padding: 16px 18px;
    border: 1px dashed var(--silver-faint);
    border-radius: 8px;
    text-decoration: none;
    color: var(--silver-dim);
  }

  .platform.live {
    border-style: solid;
    border-color: rgba(157, 178, 255, 0.45);
    color: var(--silver);
  }

  .platform.live:hover {
    background: rgba(157, 178, 255, 0.06);
  }

  .name {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
  }

  /* The stone, as on the title's choices: the way in that is open now. */
  .name .pebble {
    flex: none;
  }

  .url {
    font-size: 0.82rem;
    color: var(--silver-faint);
  }

  .live .url {
    color: var(--glass);
  }

  .where .btn {
    justify-self: start;
    margin-top: 10px;
  }

  .note {
    padding: clamp(26px, 4vw, 40px) clamp(26px, 4vw, 44px);
    border-radius: 2px 4px 3px 2px;
    background:
      radial-gradient(circle at 88% 10%, rgba(150, 110, 60, 0.14), transparent 40%),
      radial-gradient(circle at 6% 94%, rgba(120, 90, 50, 0.12), transparent 36%), #f4f1ea;
    box-shadow:
      0 30px 80px rgba(0, 0, 0, 0.7),
      inset 0 0 40px rgba(120, 90, 50, 0.16);
    color: var(--paper-ink);
    transform: rotate(1.2deg);
  }

  .note h3 {
    margin: 0 0 1em;
    font: 600 0.8rem/1 var(--sans);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--paper-ink-faint);
  }

  .note ul {
    margin: 0;
    padding: 0;
    list-style: none;
    font:
      400 1rem/1.6 'Courier New',
      Courier,
      monospace;
  }

  .note li {
    padding: 0.35em 0 0.35em 1.6em;
    position: relative;
  }

  .note li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--paper-ink-faint);
  }

  /* Typed last, and underlined by hand in pencil. */
  .caveat {
    margin: 1.4em 0 0;
    padding-top: 1em;
    border-top: 1px dashed rgba(46, 33, 24, 0.3);
    font:
      700 0.95rem/1.5 'Courier New',
      Courier,
      monospace;
    color: var(--paper-ink);
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .note {
      transform: rotate(0.6deg);
    }
  }
</style>
