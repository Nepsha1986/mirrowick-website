---
import { Image, getImage } from 'astro:assets';
import Paper from '../Paper.astro';
import { t, type Locale } from '../../i18n';
import porch from '../../assets/shots/home-porch.png';
import driveway from '../../assets/shots/home-driveway.png';
import garage from '../../assets/shots/home-garage.png';
import evening from '../../assets/shots/home-evening.png';
import night from '../../assets/shots/home-night.png';
import checkpoint from '../../assets/shots/tomorrow-checkpoint.png';
import fight from '../../assets/shots/tomorrow-fight.png';
import exp from '../../assets/shots/tomorrow-exp.png';
import director from '../../assets/shots/tomorrow-director.png';
import staff from '../../assets/shots/tomorrow-staff.png';
import cornered from '../../assets/shots/tomorrow-fight-2.png';
import vivarium from '../../assets/shots/tomorrow-vivarium.png';

interface Props {
  lang: Locale;
}

const m = t(Astro.props.lang).gallery;
/** In page order: the daylight first, then the dark. `lift` brightens a dark one a little. */
const shots = [
  { key: 'porch', src: porch },
  { key: 'evening', src: evening },
  { key: 'fight', src: fight, lift: 1.3 },
  { key: 'driveway', src: driveway },
  { key: 'checkpoint', src: checkpoint, lift: 1.3 },
  { key: 'night', src: night, lift: 1.2 },
  { key: 'exp', src: exp, lift: 1.2 },
  { key: 'garage', src: garage },
  { key: 'director', src: director, lift: 1.35 },
  { key: 'cornered', src: cornered, lift: 1.3 },
  { key: 'staff', src: staff, lift: 1.35 },
  { key: 'vivarium', src: vivarium, lift: 1.3 },
] as const;
/** Each print lies a little askew, as photos on a desk do. */
const TURNS = [-1.6, 1.1, -0.6, 1.8, 0.7, -1.3, 1.5, -0.9, 0.4, -1.8, 1.2, -0.4];
const items = await Promise.all(
  shots.map(async (s) => ({
    ...s,
    alt: m.shots[s.key],
    big: (await getImage({ src: s.src, width: 1512, format: 'webp' })).src,
  })),
);
---

<Paper class="gallery" seed={8}>
  <div class="wrap">
    <h2 data-reveal>{m.title}</h2>
    <ul class="grid">
      {
        items.map((s, i) => (
          <li
            data-reveal
            style={`transition-delay:${(i % 4) * 0.06}s;--turn:${TURNS[i % TURNS.length]}deg`}
          >
            <a href={s.big} data-big={s.big} aria-label={`${m.open}: ${s.alt}`}>
              <Image
                src={s.src}
                alt={s.alt}
                widths={[400, 640]}
                sizes="(max-width: 640px) 50vw, (max-width: 1000px) 33vw, 290px"
                style={'lift' in s ? `filter:brightness(${s.lift})` : undefined}
              />
              <span class="label">{s.alt}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
  <dialog class="box" aria-label={m.title}>
    <form method="dialog">
      <button class="close" aria-label={m.close}>×</button>
    </form>
    <img alt="" />
    <p class="caption"></p>
  </dialog>
</Paper>

<script>
  // A click opens the shot large over the page; Esc, the cross or a click outside closes it.
  for (const section of document.querySelectorAll<HTMLElement>('.gallery')) {
    const box = section.querySelector('dialog')!;
    const img = box.querySelector('img')!;
    const caption = box.querySelector('.caption')!;
    for (const a of section.querySelectorAll<HTMLAnchorElement>('a[data-big]')) {
      a.addEventListener('click', (e) => {
        e.preventDefault();
        const thumb = a.querySelector('img')!;
        img.src = a.dataset.big!;
        img.alt = thumb.alt;
        img.style.filter = thumb.style.filter;
        caption.textContent = thumb.alt;
        box.showModal();
      });
    }
    box.addEventListener('click', (e) => {
      if (e.target === box) box.close();
    });
  }
</script>

<style>
  h2 {
    margin-bottom: clamp(28px, 4vw, 48px);
  }

  .grid {
    align-items: start;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(18px, 2.4vw, 30px);
  }

  /* A print: the shot in a pale border, a line written under it. */
  .grid a {
    display: block;
    padding: 8px 8px 10px;
    background: #fbf8f1;
    box-shadow:
      0 1px 2px rgba(60, 40, 20, 0.2),
      0 12px 26px rgba(60, 40, 20, 0.22);
    transform: rotate(var(--turn));
    text-decoration: none;
    transition:
      transform 0.35s ease,
      box-shadow 0.35s ease;
  }

  .grid a:hover {
    transform: rotate(0deg) translateY(-4px) scale(1.03);
    box-shadow:
      0 2px 4px rgba(60, 40, 20, 0.2),
      0 22px 40px rgba(60, 40, 20, 0.28);
  }

  .grid :global(img) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    background: var(--night);
  }

  .label {
    display: block;
    margin-top: 8px;
    font: italic 500 1rem/1.25 var(--serif);
    color: var(--hand);
  }

  .box {
    max-width: min(1400px, 100vw - 32px);
    max-height: calc(100vh - 32px);
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--ink);
    color: var(--silver);
    overflow: hidden;
  }

  .box::backdrop {
    background: rgba(2, 3, 6, 0.88);
    backdrop-filter: blur(4px);
  }

  .box img {
    display: block;
    max-width: 100%;
    max-height: calc(100vh - 100px);
    margin: 0 auto;
  }

  .caption {
    margin: 0;
    padding: 12px 18px;
    font-size: 0.9rem;
    color: var(--silver-dim);
  }

  .close {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--silver-faint);
    background: rgba(5, 6, 8, 0.7);
    color: var(--silver);
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
  }

  @media (max-width: 1000px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
    }
  }
</style>
