---
import PostCard from '../PostCard.astro';
import Heading from '../Heading.astro';
import { href, t, type Locale } from '../../i18n';
import { postsIn } from '../../lib/news';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const m = t(lang).news;
const posts = (await postsIn(lang)).slice(0, 3);
---

{
  posts.length > 0 && (
    <section class="section news">
      <div class="wrap">
        <div class="head">
          <Heading kicker={m.kicker} title={m.latest} sign="11" />
          <a href={href(lang, 'news')}>{m.all} →</a>
        </div>
        <div class="grid">
          {posts.map((post) => (
            <PostCard post={post} lang={lang} />
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: clamp(32px, 5vw, 60px);
  }

  .head :global(.heading) {
    margin: 0;
  }

  .head a {
    text-decoration: none;
    font-size: 0.95rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 20px;
  }
</style>
