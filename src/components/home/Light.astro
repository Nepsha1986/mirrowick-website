---
import { Image } from 'astro:assets';
import { t, type Locale } from '../../i18n';
import shot from '../../assets/shots/tomorrow-vivarium.png';

interface Props {
  lang: Locale;
}

const m = t(Astro.props.lang).light;
---

<section class="section light">
  <div class="wrap grid">
    <div class="copy" data-reveal>
      <h2>{m.title}</h2>
      <p class="lead">{m.lead}</p>
    </div>
    <div class="shot" data-reveal>
      <Image src={shot} alt="" widths={[640, 960, 1400]} sizes="(max-width: 900px) 100vw, 640px" />
    </div>
    <ul class="points">
      {
        m.points.map((p, i) => (
          <li data-reveal style={`transition-delay:${i * 0.1}s`}>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .light {
    background: radial-gradient(60% 50% at 70% 40%, rgba(255, 90, 80, 0.05), transparent 70%);
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }

  .shot {
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--line);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.6);
  }

  .shot :global(img) {
    width: 100%;
    filter: brightness(1.25);
  }

  .points {
    grid-column: 1 / -1;
    list-style: none;
    margin: clamp(24px, 4vw, 48px) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }

  .points li {
    padding-top: 22px;
    border-top: 1px solid var(--line);
  }

  .points h3 {
    font-size: 1.45rem;
  }

  .points p {
    color: var(--silver-dim);
    margin: 0;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .points {
      grid-template-columns: 1fr;
    }
  }
</style>
