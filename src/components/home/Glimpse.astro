---
import { Image } from 'astro:assets';
import { t, type Locale } from '../../i18n';
import shot from '../../assets/shots/tomorrow-chamber-7.png';

interface Props {
  lang: Locale;
}

const m = t(Astro.props.lang).glimpse;
---

<section class="glimpse">
  <div class="wrap">
    <figure data-reveal>
      <Image
        src={shot}
        alt={m.alt}
        widths={[760, 1200, 1512]}
        sizes="(max-width: 1200px) 100vw, 1160px"
      />
      <figcaption>{m.line}</figcaption>
    </figure>
  </div>
</section>

<style>
  .glimpse {
    padding-block: clamp(72px, 10vw, 140px);
  }

  figure {
    position: relative;
    margin: 0;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--line);
    box-shadow: 0 40px 120px rgba(0, 0, 0, 0.7);
  }

  figure :global(img) {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  /* The dark gathers at the edges and under the line. */
  figure::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(70% 70% at 50% 42%, transparent 55%, rgba(5, 6, 8, 0.7)),
      linear-gradient(transparent 60%, rgba(5, 6, 8, 0.85));
    pointer-events: none;
  }

  figcaption {
    position: absolute;
    z-index: 1;
    left: 0;
    right: 0;
    bottom: clamp(20px, 4vw, 48px);
    padding-inline: var(--gutter);
    text-align: center;
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.4rem, 3.2vw, 2.4rem);
    line-height: 1.25;
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.8);
  }
</style>
