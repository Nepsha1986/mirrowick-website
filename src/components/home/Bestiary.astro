---
import { Image } from 'astro:assets';
import Rune from '../Rune.astro';
import { t, type Locale } from '../../i18n';
import shot from '../../assets/shots/tomorrow-gallery.png';

interface Props {
  lang: Locale;
}

const m = t(Astro.props.lang).bestiary;
/** A seal sign for each card: decoration only, the signs mean nothing yet. */
const foes = [
  { ...m.foes.shade, sign: '03' },
  { ...m.foes.chimers, sign: '06' },
  { ...m.foes.crawler, sign: '09' },
];
---

<section class="section bestiary">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <h2>{m.title}</h2>
      <p class="lead">{m.lead}</p>
    </div>
    <div class="shot" data-reveal>
      <Image
        src={shot}
        alt={`${m.foes.crawler.name}, ${m.foes.chimers.name}`}
        widths={[640, 960, 1312]}
        sizes="(max-width: 1200px) 100vw, 1160px"
      />
    </div>
    <ul class="cards">
      {
        foes.map((f, i) => (
          <li data-reveal style={`transition-delay:${i * 0.1}s`}>
            <Rune sign={f.sign} class="sign" stroke={2.2} />
            <h3>{f.name}</h3>
            <p>{f.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .shot {
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--line);
    aspect-ratio: 1312 / 500;
  }

  .shot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(1.45) contrast(1.05);
  }

  .cards {
    list-style: none;
    margin: 28px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .cards li {
    padding: 28px 26px 22px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: linear-gradient(180deg, var(--ink-3), var(--ink-2));
  }

  .cards :global(.sign) {
    width: 46px;
    height: 46px;
    color: var(--glass);
    margin-bottom: 14px;
    filter: drop-shadow(0 0 6px var(--glass-glow));
  }

  .cards p {
    color: var(--silver-dim);
    margin: 0;
  }

  @media (max-width: 900px) {
    .cards {
      grid-template-columns: 1fr;
    }
    .shot {
      aspect-ratio: 16 / 9;
    }
  }
</style>
