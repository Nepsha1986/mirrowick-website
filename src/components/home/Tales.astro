---
import { Image } from 'astro:assets';
import Paper from '../Paper.astro';
import { fill, t, type Locale } from '../../i18n';

interface Props {
  lang: Locale;
}

const m = t(Astro.props.lang).tales;
/** The intro's pencil film, one picture per year (src/assets/film/<year>.png). */
const frames = import.meta.glob<{ default: ImageMetadata }>('../../assets/film/*.png', {
  eager: true,
});
const years = Object.entries(frames)
  .map(([path, mod]) => ({ year: path.match(/(\d{4})\.png$/)![1], src: mod.default }))
  .sort((a, b) => Number(a.year) - Number(b.year));
---

<Paper class="tales" seed={3}>
  <div class="wrap grid">
    <div class="copy" data-reveal>
      <h2>{m.title}</h2>
      <p class="lead">{m.lead}</p>
      <ul class="lines">
        {m.lines.map((line) => <li>{line}</li>)}
      </ul>
      <p class="coda">{m.coda}</p>
    </div>

    <figure class="film" data-film data-reveal>
      <div class="frames">
        {
          years.map(({ year, src }, i) => (
            <Image
              src={src}
              alt={fill(m.film, { year })}
              widths={[640, 960, 1440]}
              sizes="(max-width: 900px) 100vw, 640px"
              class:list={['frame', { on: i === years.length - 1 }]}
              data-year={year}
              loading={i === years.length - 1 ? 'eager' : 'lazy'}
            />
          ))
        }
      </div>
      <div class="years" role="group" aria-label={m.years}>
        {
          years.map(({ year }, i) => (
            <button
              type="button"
              data-year={year}
              aria-pressed={i === years.length - 1 ? 'true' : 'false'}
            >
              {year}
            </button>
          ))
        }
      </div>
    </figure>
  </div>
</Paper>

<script>
  // Pick a year to see the town then; on its own it walks through them slowly.
  for (const fig of document.querySelectorAll<HTMLElement>('[data-film]')) {
    const frames = [...fig.querySelectorAll<HTMLElement>('.frame')];
    const buttons = [...fig.querySelectorAll<HTMLButtonElement>('button')];
    let at = frames.length - 1;
    const show = (i: number) => {
      at = i;
      frames.forEach((f, k) => f.classList.toggle('on', k === i));
      buttons.forEach((b, k) => b.setAttribute('aria-pressed', String(k === i)));
    };
    let timer = 0;
    const walk = () => {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      timer = window.setInterval(() => show((at + 1) % frames.length), 4500);
    };
    buttons.forEach((b, i) =>
      b.addEventListener('click', () => {
        clearInterval(timer);
        show(i);
      }),
    );
    new IntersectionObserver(([e]) => {
      clearInterval(timer);
      if (e.isIntersecting && !fig.dataset.picked) walk();
    }).observe(fig);
    fig.addEventListener('click', () => (fig.dataset.picked = '1'), { once: true });
  }
</script>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(36px, 6vw, 88px);
    align-items: center;
  }

  h2 {
    margin-bottom: 0.3em;
  }

  .lead {
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.35rem;
  }

  /* The tales as if written down by hand, in the blue ink of the notes. */
  .lines {
    list-style: none;
    margin: 1.6em 0;
    padding: 0;
    display: grid;
    gap: 0.7em;
  }

  .lines li {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    line-height: 1.35;
    color: var(--hand);
  }

  .coda {
    margin: 0;
    padding-top: 1.2em;
    border-top: 1px solid rgba(46, 33, 24, 0.18);
  }

  .film {
    margin: 0;
  }

  .frames {
    position: relative;
    aspect-ratio: 1920 / 1200;
    transform: rotate(0.6deg);
    filter: drop-shadow(0 18px 30px rgba(60, 40, 20, 0.28));
  }

  .frames :global(.frame) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.2s ease;
  }

  .frames :global(.frame.on) {
    opacity: 1;
  }

  .years {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px 6px;
    margin-top: 18px;
  }

  .years button {
    font: 500 0.95rem/1 var(--serif);
    letter-spacing: 0.06em;
    padding: 6px 10px;
    border: 0;
    border-radius: 4px;
    background: transparent;
    color: var(--paper-ink-faint);
    cursor: pointer;
  }

  .years button:hover {
    color: var(--paper-ink);
  }

  .years button[aria-pressed='true'] {
    color: var(--paper-ink);
    box-shadow: inset 0 -1px 0 var(--paper-ink);
  }

  .years button:focus-visible {
    outline-color: var(--hand);
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .film {
      order: -1;
    }
  }
</style>
