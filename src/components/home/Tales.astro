---
import { t, type Locale } from '../../i18n';

interface Props {
  lang: Locale;
}

const m = t(Astro.props.lang);
---

<section class="section tales">
  <div class="wrap narrow">
    <h2 data-reveal>{m.tales.title}</h2>
    <ul>
      {
        m.tales.lines.map((line, i) => (
          <li data-reveal style={`transition-delay:${i * 0.12}s`}>
            {line}
          </li>
        ))
      }
    </ul>
    <p class="coda" data-reveal>{m.tales.coda}</p>
  </div>
</section>

<style>
  .narrow {
    max-width: 820px;
    text-align: center;
  }

  h2 {
    margin-bottom: 1.2em;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.9em;
  }

  li {
    font-family: var(--serif);
    font-size: clamp(1.3rem, 2.4vw, 1.75rem);
    line-height: 1.35;
    color: var(--silver-dim);
  }

  .coda {
    margin: 2.4em auto 0;
    max-width: 30ch;
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    line-height: 1.3;
    color: var(--silver);
  }
</style>
