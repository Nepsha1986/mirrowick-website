---
import Wordmark from './Wordmark.astro';
import Rune from './Rune.astro';
import { fill, href, t, type Locale } from '../i18n';
import { PLAY_URL } from '../site';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const m = t(lang);
/** The seal's twelve signs, in a row along the foot of every page. */
const SIGNS = Array.from({ length: 12 }, (_, i) => String(i + 1).padStart(2, '0'));
---

<footer class="footer">
  <hr class="iris" />
  <div class="wrap signs" data-reveal aria-hidden="true">
    {
      SIGNS.map((sign, i) => (
        <span style={`--chalk-delay:${0.1 + i * 0.12}s`}>
          <Rune sign={sign} class="chalk" stroke={3} />
        </span>
      ))
    }
  </div>
  <div class="wrap inner">
    <div>
      <a class="brand" href={href(lang)}><Wordmark /></a>
    </div>
    <nav class="links" aria-label="Footer">
      <a href={PLAY_URL} target="_blank" rel="noopener">{m.nav.play}</a>
      <a href={href(lang, 'news')}>{m.nav.news}</a>
    </nav>
    <p class="small">
      {fill(m.footer.made, { year: new Date().getFullYear() })}
    </p>
  </div>
</footer>

<style>
  .footer {
    margin-top: 40px;
  }

  .signs {
    display: flex;
    justify-content: space-between;
    padding-top: 36px;
    color: var(--silver-faint);
  }

  .signs span {
    width: clamp(18px, 2.4vw, 28px);
    height: clamp(18px, 2.4vw, 28px);
  }

  .signs :global(svg) {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 24px 40px;
    padding-block: 48px 40px;
  }

  .brand {
    font-size: 2rem;
    text-decoration: none;
  }

  .links {
    display: flex;
    gap: 24px;
    align-items: flex-start;
    flex-wrap: wrap;
  }

  .links a {
    color: var(--silver-dim);
    text-decoration: none;
    font-size: 0.9rem;
  }

  .links a:hover {
    color: var(--silver);
  }

  .small {
    grid-column: 1 / -1;
    margin: 0;
    font-size: 0.8rem;
    color: var(--silver-faint);
  }

  @media (max-width: 640px) {
    .inner {
      grid-template-columns: 1fr;
    }
  }
</style>
