---
import Rune from './Rune.astro';

/**
 * The seal round the glass, as the game's title screen shows it: a chalk
 * ring with the twelve signs, white stones on eight of them (four taken
 * away, as Victor left it), and in the middle the glass, a well of violet
 * light. It turns once in five minutes, like the title.
 */
const SIGNS = Array.from({ length: 12 }, (_, i) => String(i + 1).padStart(2, '0'));
/** Which signs lost their stone. */
const TAKEN = new Set([1, 4, 7, 10]);
const R = 360;
const SIZE = 74;
const spots = SIGNS.map((sign, i) => {
  const a = (i / SIGNS.length) * Math.PI * 2 - Math.PI / 2;
  return { sign, i, x: Math.cos(a) * R, y: Math.sin(a) * R, deg: (a * 180) / Math.PI + 90 };
});
/** Sparks over the glass: fixed, so the page looks the same every time. */
const sparks = Array.from({ length: 26 }, (_, i) => {
  const a = i * 2.39996;
  const d = 40 + ((i * 37) % 170);
  return { x: Math.cos(a) * d, y: Math.sin(a) * d, r: 1.2 + (i % 3) * 0.7, delay: (i * 0.73) % 6 };
});
---

<div class="seal" aria-hidden="true">
  <svg viewBox="-500 -500 1000 1000">
    <defs>
      <radialGradient id="glass">
        <stop offset="0" stop-color="#8f7bff" stop-opacity="0.95"></stop>
        <stop offset="0.35" stop-color="#3a2a99" stop-opacity="0.7"></stop>
        <stop offset="0.7" stop-color="#140f38" stop-opacity="0.35"></stop>
        <stop offset="1" stop-color="#050608" stop-opacity="0"></stop>
      </radialGradient>
      <radialGradient id="stone">
        <stop offset="0" stop-color="#ffffff"></stop>
        <stop offset="0.45" stop-color="#dfe4ff" stop-opacity="0.9"></stop>
        <stop offset="1" stop-color="#9db2ff" stop-opacity="0"></stop>
      </radialGradient>
    </defs>
    <circle class="depth" r="300" fill="url(#glass)"></circle>
    <g class="turn">
      <circle class="chalk" r={R + 52}></circle>
      <circle class="chalk thin" r={R - 50}></circle>
      {
        spots.map((s) => (
          <g transform={`translate(${s.x} ${s.y}) rotate(${s.deg})`}>
            <Rune sign={s.sign} class="sign" stroke={3} x={-SIZE / 2} y={-SIZE / 2} size={SIZE} />
            {!TAKEN.has(s.i) && (
              <circle
                class="stone"
                r="20"
                fill="url(#stone)"
                style={`animation-delay:${-s.i * 0.9}s`}
              />
            )}
          </g>
        ))
      }
    </g>
    <g class="sparks">
      {
        sparks.map((p) => (
          <circle cx={p.x} cy={p.y} r={p.r} style={`animation-delay:${-p.delay}s`} />
        ))
      }
    </g>
    <circle class="rim" r="62"></circle>
  </svg>
</div>

<style>
  .seal {
    width: 100%;
    aspect-ratio: 1;
    position: relative;
  }

  svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .turn {
    animation: turn 300s linear infinite;
    transform-origin: 0 0;
  }

  .chalk {
    fill: none;
    stroke: rgba(223, 228, 236, 0.5);
    stroke-width: 2.4;
    stroke-dasharray: 380 9 120 6 520 14;
  }

  .chalk.thin {
    stroke: rgba(223, 228, 236, 0.22);
    stroke-width: 1.5;
    stroke-dasharray: none;
  }

  .sign {
    color: rgba(223, 228, 236, 0.62);
  }

  .stone {
    mix-blend-mode: screen;
    animation: breathe 7s ease-in-out infinite;
  }

  .depth {
    animation: breathe 9s ease-in-out infinite;
  }

  .rim {
    fill: rgba(5, 4, 15, 0.4);
    stroke: rgba(157, 178, 255, 0.25);
    stroke-width: 1;
  }

  .sparks circle {
    fill: #e6ecff;
    opacity: 0;
    animation: spark 6s ease-in-out infinite;
  }

  @keyframes turn {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes breathe {
    0%,
    100% {
      opacity: 0.75;
    }
    50% {
      opacity: 1;
    }
  }

  @keyframes spark {
    0%,
    100% {
      opacity: 0;
    }
    50% {
      opacity: 0.85;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .turn,
    .stone,
    .depth,
    .sparks circle {
      animation: none;
    }
    .sparks circle {
      opacity: 0.5;
    }
  }
</style>
