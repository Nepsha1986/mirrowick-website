---
import Rune from './Rune.astro';

/**
 * A section's title as the game's menu sets its own: a small spaced line
 * over it with a sign of the seal and its stone, the title in light serif
 * with the glass's glow, a thin line of the glass's colours under it. The
 * sign draws itself in chalk as the title comes into view, then the stone
 * is laid on its ring. On old paper (`Paper.astro`) it is pencil instead.
 */
interface Props {
  /** The small line over the title. */
  kicker: string;
  title: string;
  lead?: string;
  /** Which of the seal's twelve signs, `01`…`12`. */
  sign: string;
  /** `h1` on a page of its own. */
  as?: 'h1' | 'h2';
  /** `small` for a long title in a narrow column. */
  size?: 'small';
  class?: string;
}

const { kicker, title, lead, sign, as: Tag = 'h2', size, class: className } = Astro.props;
---

<header class:list={['heading', size, className]} data-reveal>
  <p class="kicker">
    <span class="sign" aria-hidden="true">
      <Rune sign={sign} class="chalk" stroke={3} />
      <i class="pebble"></i>
    </span>
    {kicker}
  </p>
  <Tag class="title">{title}</Tag>
  <span class="rule" aria-hidden="true"></span>
  {lead && <p class="lead">{lead}</p>}
  <slot />
</header>

<style>
  .heading {
    margin-bottom: clamp(32px, 5vw, 60px);
  }

  .kicker {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0 0 18px;
    font: 500 0.72rem/1.4 var(--sans);
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--silver-dim);
  }

  /* The sign, with its stone on the ring in its middle. */
  .sign {
    position: relative;
    flex: none;
    width: 34px;
    height: 34px;
    color: var(--silver-dim);
  }

  .sign :global(svg) {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .pebble {
    position: absolute;
    left: calc(50% - 6px);
    top: calc(50% - 4.5px);
    transition:
      opacity 0.6s ease 1.1s,
      scale 0.6s ease 1.1s;
  }

  :global(.js) .heading:not(:global(.shown)) .pebble {
    opacity: 0;
    scale: 0.7;
  }

  :global(.shown) .kicker .pebble {
    opacity: 1;
    scale: 1;
    animation: breathe 6s ease-in-out 1.8s infinite;
  }

  .title {
    margin: 0;
    font-weight: 300;
    font-size: clamp(2.5rem, 5.4vw, 4rem);
    line-height: 1.02;
    letter-spacing: 0.035em;
    text-shadow: 0 0 40px rgba(140, 165, 255, 0.25);
  }

  .small .title {
    font-size: clamp(2.1rem, 3.6vw, 3rem);
  }

  h1.title {
    font-size: clamp(2.8rem, 6.4vw, 4.8rem);
  }

  /* The glass's colours, drawn out from the left as the title comes in. */
  .rule {
    display: block;
    width: min(320px, 70%);
    height: 1px;
    margin: 22px 0 0 2px;
    background: var(--iris);
    opacity: 0.85;
    transform-origin: left;
    transition: transform 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) 0.4s;
  }

  :global(.js) .heading:not(:global(.shown)) .rule {
    transform: scaleX(0);
  }

  .lead {
    margin: 22px 0 0;
  }

  /* On old paper: pencil and ink, no glow, a stone of grey river rock. */
  :global(.paper) .kicker {
    color: var(--paper-ink-faint);
  }

  :global(.paper) .sign {
    color: var(--hand);
  }

  :global(.paper) .pebble {
    background:
      radial-gradient(ellipse 45% 35% at 34% 32%, rgba(225, 230, 232, 0.5), transparent 70%),
      radial-gradient(circle 1px at 70% 58%, rgba(90, 90, 86, 0.5), transparent),
      radial-gradient(ellipse at 45% 40%, #aeb3b4 55%, #84898b);
    box-shadow: 1px 1.5px 1px rgba(0, 0, 0, 0.35);
  }

  :global(.paper) .title {
    color: var(--paper-ink);
    font-weight: 400;
    text-shadow: none;
  }

  :global(.paper) .rule {
    height: 1.5px;
    background: linear-gradient(
      90deg,
      rgba(46, 33, 24, 0.55),
      rgba(46, 33, 24, 0.35) 70%,
      transparent
    );
    border-radius: 1px;
  }

  @keyframes breathe {
    50% {
      filter: brightness(1.25);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rule,
    .pebble {
      transition: none;
    }
  }
</style>
