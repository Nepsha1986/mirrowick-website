---
/**
 * A sheet of old paper laid across the dark page, like the game's notes:
 * ragged top and bottom edges (seeded, so the same every build), stains,
 * pencil-dark ink.
 */
interface Props {
  class?: string;
  id?: string;
  /** Picks the edges' shape. */
  seed?: number;
  /** A touch of turn, in degrees. */
  tilt?: number;
}

const { class: className, id, seed = 1, tilt = 0 } = Astro.props;

/** mulberry32, as the game seeds everything it paints. */
function rng(a: number) {
  return () => {
    a |= 0;
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const R = rng(seed * 7919);
const STEPS = 48;
const edge = (y: number, dir: 1 | -1) =>
  Array.from({ length: STEPS + 1 }, (_, i) => {
    const x = (i / STEPS) * 100;
    const dy = (R() * 0.9 + (i % 7 === 3 ? R() * 0.8 : 0)) * dir;
    return `${x.toFixed(2)}% calc(${y}% + ${dy.toFixed(2)}vw)`;
  });
const top = edge(0, 1);
const bottom = edge(100, -1).reverse();
const clip = `polygon(${[...top, ...bottom].join(',')})`;
---

<section class:list={['paper', className]} id={id} style={`--clip:${clip};--tilt:${tilt}deg`}>
  <slot />
</section>

<style>
  .paper {
    position: relative;
    color: var(--paper-ink);
    background:
      radial-gradient(circle at 86% 14%, rgba(150, 110, 60, 0.14), transparent 38%),
      radial-gradient(circle at 8% 88%, rgba(120, 90, 50, 0.12), transparent 34%),
      radial-gradient(120% 90% at 50% 50%, transparent 60%, rgba(110, 70, 30, 0.16)), var(--paper);
    clip-path: var(--clip);
    transform: rotate(var(--tilt));
    padding-block: clamp(80px, 11vw, 150px);
    margin-block: -1vw;
    box-shadow: inset 0 0 80px rgba(120, 90, 50, 0.18);
  }

  .paper :global(h2),
  .paper :global(h3) {
    color: var(--paper-ink);
  }

  .paper :global(.lead),
  .paper :global(p) {
    color: var(--paper-ink-dim);
  }

  .paper :global(.eyebrow) {
    color: var(--paper-ink-faint);
  }

  .paper :global(a) {
    color: var(--hand);
    text-decoration-color: rgba(35, 50, 86, 0.4);
  }
</style>
