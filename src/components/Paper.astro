---
/**
 * A sheet of old paper laid across the dark page, like the game's notes:
 * its top and bottom edges burnt away (a noise-bent edge, seeded, so the
 * same every build, with the scorch running in from it), stains,
 * pencil-dark ink.
 */
interface Props {
  class?: string;
  id?: string;
  /** Picks the burn's shape. */
  seed?: number;
}

const { class: className, id, seed = 1 } = Astro.props;
const uid = `burn-${seed}`;
---

<section class:list={['paper', className]} id={id}>
  {
    (['top', 'bottom'] as const).map((side, i) => (
      <svg
        class:list={['edge', side]}
        viewBox="0 0 1600 140"
        preserveAspectRatio="none"
        aria-hidden="true"
        focusable="false"
      >
        <defs>
          {/* The burnt line: big slow bites, then fine fraying on them. */}
          <filter
            id={`${uid}-${side}`}
            x="-5%"
            y="-60%"
            width="110%"
            height="220%"
            color-interpolation-filters="sRGB"
          >
            <feTurbulence
              type="fractalNoise"
              baseFrequency="0.0045 0.018"
              numOctaves="5"
              seed={seed * 11 + i}
              result="noise"
            />
            <feDisplacementMap
              in="SourceGraphic"
              in2="noise"
              scale="90"
              xChannelSelector="R"
              yChannelSelector="G"
            />
          </filter>
          {/* The scorch: the same line, softened, running brown into the sheet. */}
          <filter
            id={`${uid}-${side}-scorch`}
            x="-5%"
            y="-60%"
            width="110%"
            height="220%"
            color-interpolation-filters="sRGB"
          >
            <feTurbulence
              type="fractalNoise"
              baseFrequency="0.0045 0.018"
              numOctaves="5"
              seed={seed * 11 + i}
              result="noise"
            />
            <feDisplacementMap
              in="SourceGraphic"
              in2="noise"
              scale="90"
              xChannelSelector="R"
              yChannelSelector="G"
            />
            <feGaussianBlur stdDeviation="7 5" />
          </filter>
        </defs>
        <rect
          x="-80"
          y="-80"
          width="1760"
          height="160"
          fill="#6b4320"
          opacity="0.55"
          filter={`url(#${uid}-${side}-scorch)`}
        />
        <rect
          x="-80"
          y="-80"
          width="1760"
          height="142"
          fill="#3a1f0b"
          opacity="0.85"
          filter={`url(#${uid}-${side}-scorch)`}
        />
        <rect
          x="-80"
          y="-80"
          width="1760"
          height="133"
          fill="#1a0c04"
          filter={`url(#${uid}-${side})`}
        />
        <rect
          x="-80"
          y="-80"
          width="1760"
          height="128"
          class="dark"
          filter={`url(#${uid}-${side})`}
        />
      </svg>
    ))
  }
  <slot />
</section>

<style>
  .paper {
    position: relative;
    color: var(--paper-ink);
    background:
      radial-gradient(circle at 86% 14%, rgba(150, 110, 60, 0.14), transparent 38%),
      radial-gradient(circle at 8% 88%, rgba(120, 90, 50, 0.12), transparent 34%),
      radial-gradient(120% 90% at 50% 50%, transparent 60%, rgba(110, 70, 30, 0.16)), var(--paper);
    padding-block: clamp(110px, 13vw, 180px);
    box-shadow: inset 0 0 80px rgba(120, 90, 50, 0.18);
    overflow: hidden;
  }

  /* The burn eats into the sheet from the dark page, top and bottom. */
  .edge {
    position: absolute;
    left: 0;
    width: 100%;
    height: clamp(70px, 8vw, 130px);
    pointer-events: none;
  }

  .edge.top {
    top: -1px;
  }

  .edge.bottom {
    bottom: -1px;
    transform: scaleY(-1);
  }

  .dark {
    fill: var(--ink);
  }

  .paper :global(h2),
  .paper :global(h3) {
    color: var(--paper-ink);
  }

  .paper :global(.lead),
  .paper :global(p) {
    color: var(--paper-ink-dim);
  }

  .paper :global(.eyebrow) {
    color: var(--paper-ink-faint);
  }

  .paper :global(a) {
    color: var(--hand);
    text-decoration-color: rgba(35, 50, 86, 0.4);
  }
</style>
